<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/loginFragment">

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.pitchcoach.app.ui.login.LoginFragment"
        android:label="@string/app_name">
        <action
            android:id="@+id/action_login_to_home"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.pitchcoach.app.ui.home.HomeFragment"
        android:label="@string/nav_home">
        <action
            android:id="@+id/action_home_to_create"
            app:destination="@id/createPresentationFragment" />
        <action
            android:id="@+id/action_home_to_detail"
            app:destination="@id/presentationDetailFragment" />
        <action
            android:id="@+id/action_home_to_all"
            app:destination="@id/allPresentationsFragment" />
    </fragment>

    <fragment
        android:id="@+id/createPresentationFragment"
        android:name="com.pitchcoach.app.ui.presentation.CreatePresentationFragment"
        android:label="@string/create_title">
        <action
            android:id="@+id/action_create_to_detail"
            app:destination="@id/presentationDetailFragment"
            app:popUpTo="@id/createPresentationFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/presentationDetailFragment"
        android:name="com.pitchcoach.app.ui.presentation.PresentationDetailFragment"
        android:label="@string/detail_title">
        <action
            android:id="@+id/action_detail_to_record"
            app:destination="@id/recordingFragment" />
        <action
            android:id="@+id/action_detail_to_progress_detail"
            app:destination="@id/progressDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/allPresentationsFragment"
        android:name="com.pitchcoach.app.ui.presentation.AllPresentationsFragment"
        android:label="@string/all_presentations_title">
        <argument
            android:name="mode"
            android:defaultValue="detail"
            app:argType="string" />
        <action
            android:id="@+id/action_all_to_detail"
            app:destination="@id/presentationDetailFragment" />
        <action
            android:id="@+id/action_all_to_record"
            app:destination="@id/recordingFragment" />
        <action
            android:id="@+id/action_all_to_create"
            app:destination="@id/createPresentationFragment" />
    </fragment>

    <fragment
        android:id="@+id/recordingFragment"
        android:name="com.pitchcoach.app.ui.practice.RecordingFragment"
        android:label="@string/presentation_mobile">
        <action
            android:id="@+id/action_record_to_analyzing"
            app:destination="@id/analyzingFragment"
            app:popUpTo="@id/recordingFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/analyzingFragment"
        android:name="com.pitchcoach.app.ui.practice.AnalyzingFragment"
        android:label="@string/analyzing_title">
        <action
            android:id="@+id/action_analyzing_to_result"
            app:destination="@id/analysisResultFragment"
            app:popUpTo="@id/analyzingFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/analysisResultFragment"
        android:name="com.pitchcoach.app.ui.practice.AnalysisResultFragment"
        android:label="@string/result_title">
        <action
            android:id="@+id/action_result_to_panel"
            app:destination="@id/aiPanelFragment" />
        <action
            android:id="@+id/action_result_to_record"
            app:destination="@id/recordingFragment"
            app:popUpTo="@id/analysisResultFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/aiPanelFragment"
        android:name="com.pitchcoach.app.ui.practice.AiPanelFragment"
        android:label="@string/panel_title">
        <argument
            android:name="current"
            android:defaultValue="0"
            app:argType="integer" />
        <action
            android:id="@+id/action_panel_to_answer"
            app:destination="@id/answerQuestionFragment" />
    </fragment>

    <fragment
        android:id="@+id/answerQuestionFragment"
        android:name="com.pitchcoach.app.ui.practice.AnswerQuestionFragment"
        android:label="@string/panel_title">
        <argument
            android:name="index"
            android:defaultValue="0"
            app:argType="integer" />
        <action
            android:id="@+id/action_answer_to_progress"
            app:destination="@id/progressFragment"
            app:popUpTo="@id/homeFragment"
            app:popUpToInclusive="false" />
    </fragment>

    <fragment
        android:id="@+id/progressFragment"
        android:name="com.pitchcoach.app.ui.progress.ProgressFragment"
        android:label="@string/nav_progress">
        <action
            android:id="@+id/action_progress_to_detail"
            app:destination="@id/progressDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/progressDetailFragment"
        android:name="com.pitchcoach.app.ui.progress.ProgressDetailFragment"
        android:label="@string/progress_detail_title">
        <action
            android:id="@+id/action_progress_detail_to_result"
            app:destination="@id/analysisResultFragment" />
        <action
            android:id="@+id/action_progress_detail_to_record"
            app:destination="@id/recordingFragment" />
    </fragment>

    <fragment
        android:id="@+id/profileFragment"
        android:name="com.pitchcoach.app.ui.profile.ProfileFragment"
        android:label="@string/profile_title">
        <action
            android:id="@+id/action_profile_to_login"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/homeFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/practiceFragment"
        android:name="com.pitchcoach.app.ui.practice.PracticeHubFragment"
        android:label="@string/nav_practice">
        <action
            android:id="@+id/action_practice_to_record"
            app:destination="@id/recordingFragment" />
        <action
            android:id="@+id/action_practice_to_all"
            app:destination="@id/allPresentationsFragment" />
        <action
            android:id="@+id/action_practice_to_panel"
            app:destination="@id/aiPanelFragment" />
    </fragment>
</navigation>
