<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Widget.PitchCoach.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:letterSpacing">0</item>
        <item name="backgroundTint">@color/primary</item>
        <item name="cornerRadius">@dimen/button_radius</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:elevation">2dp</item>
        <item name="rippleColor">@color/white</item>
        <item name="iconTint">@color/white</item>
        <item name="iconPadding">8dp</item>
        <item name="iconGravity">textStart</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
    </style>

    <style name="Widget.PitchCoach.Button.Accent" parent="Widget.Material3.Button">
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:letterSpacing">0</item>
        <item name="backgroundTint">@color/accent</item>
        <item name="cornerRadius">@dimen/button_radius</item>
        <item name="android:elevation">2dp</item>
        <item name="rippleColor">@color/white</item>
        <item name="iconTint">@color/white</item>
        <item name="iconPadding">8dp</item>
        <item name="iconGravity">textStart</item>
    </style>

    <style name="Widget.PitchCoach.Button.Outline" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/primary</item>
        <item name="android:letterSpacing">0</item>
        <item name="backgroundTint">@color/transparent</item>
        <item name="strokeColor">@color/border_strong</item>
        <item name="strokeWidth">1dp</item>
        <item name="cornerRadius">@dimen/button_radius</item>
        <item name="rippleColor">@color/primary_container</item>
        <item name="iconTint">@color/primary</item>
        <item name="iconPadding">8dp</item>
        <item name="iconGravity">textStart</item>
    </style>

    <style name="Widget.PitchCoach.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:minHeight">40dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:paddingEnd">4dp</item>
        <item name="android:textColor">@color/primary</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="rippleColor">@color/primary_container</item>
    </style>

    <style name="Widget.PitchCoach.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="cardCornerRadius">@dimen/card_radius</item>
        <item name="cardElevation">2dp</item>
        <item name="cardPreventCornerOverlap">true</item>
        <item name="strokeWidth">0dp</item>
        <item name="rippleColor">@color/primary_container</item>
    </style>

    <style name="Widget.PitchCoach.Card.Flat" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="cardCornerRadius">@dimen/card_radius</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">0dp</item>
        <item name="rippleColor">@color/primary_container</item>
    </style>

    <style name="Widget.PitchCoach.Chip.Filter" parent="Widget.Material3.Chip.Filter">
        <item name="android:minHeight">38dp</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/chip_filter_text</item>
        <item name="chipBackgroundColor">@color/chip_filter_background</item>
        <item name="chipStrokeColor">@color/chip_filter_stroke</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="chipCornerRadius">19dp</item>
        <item name="chipMinHeight">38dp</item>
        <item name="chipStartPadding">12dp</item>
        <item name="chipEndPadding">12dp</item>
        <item name="checkedIconVisible">false</item>
        <item name="android:checkable">true</item>
        <item name="rippleColor">@color/primary_container</item>
    </style>

    <style name="Widget.PitchCoach.Chip.Choice" parent="Widget.Material3.Chip.Filter">
        <item name="android:minHeight">40dp</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/choice_chip_text</item>
        <item name="chipBackgroundColor">@color/choice_chip_background</item>
        <item name="chipStrokeColor">@color/choice_chip_stroke</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="chipCornerRadius">20dp</item>
        <item name="chipMinHeight">40dp</item>
        <item name="chipStartPadding">13dp</item>
        <item name="chipEndPadding">13dp</item>
        <item name="checkedIcon">@drawable/ic_check_small</item>
        <item name="checkedIconTint">@color/primary</item>
        <item name="checkedIconVisible">true</item>
        <item name="android:checkable">true</item>
        <item name="rippleColor">@color/primary_container</item>
    </style>

    <style name="Widget.PitchCoach.BottomNav" parent="Widget.Material3.BottomNavigationView">
        <item name="itemActiveIndicatorStyle">@style/Widget.PitchCoach.BottomNav.ActiveIndicator</item>
        <item name="itemIconTint">@color/bottom_nav_item</item>
        <item name="itemTextColor">@color/bottom_nav_item</item>
        <item name="itemTextAppearanceActive">@style/TextAppearance.PitchCoach.BottomNav.Active</item>
        <item name="itemTextAppearanceInactive">@style/TextAppearance.PitchCoach.BottomNav.Inactive</item>
        <item name="labelVisibilityMode">labeled</item>
        <item name="elevation">0dp</item>
        <item name="backgroundTint">@color/nav_background</item>
        <item name="itemPaddingTop">6dp</item>
    </style>

    <style name="Widget.PitchCoach.BottomNav.ActiveIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/primary_container_strong</item>
        <item name="shapeAppearance">@style/ShapeAppearance.PitchCoach.Pill</item>
    </style>

    <style name="ShapeAppearance.PitchCoach.Pill" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">18dp</item>
    </style>

    <style name="TextAppearance.PitchCoach.BottomNav.Active" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="fontFamily">@font/inter</item>
    </style>

    <style name="TextAppearance.PitchCoach.BottomNav.Inactive" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">normal</item>
        <item name="fontFamily">@font/inter</item>
    </style>

    <style name="TextAppearance.PitchCoach.Kicker" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_muted</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="TextAppearance.PitchCoach.Title" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>

    <style name="TextAppearance.PitchCoach.SectionTitle" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <style name="TextAppearance.PitchCoach.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.PitchCoach.Muted" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/text_muted</item>
    </style>

    <style name="TextAppearance.PitchCoach.Label" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="Widget.PitchCoach.AppBar.Back" parent="Widget.Material3.Button.IconButton">
        <item name="android:minWidth">48dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="iconSize">24dp</item>
        <item name="iconTint">@color/text_primary</item>
        <item name="iconGravity">textStart</item>
        <item name="backgroundTint">@color/transparent</item>
        <item name="rippleColor">@color/primary_container</item>
    </style>

    <style name="Widget.PitchCoach.Tabs" parent="Widget.Material3.TabLayout">
        <item name="tabIndicatorColor">@color/primary</item>
        <item name="tabSelectedTextColor">@color/primary</item>
        <item name="tabTextColor">@color/text_muted</item>
        <item name="tabIndicatorFullWidth">true</item>
        <item name="tabIndicatorHeight">2dp</item>
        <item name="tabRippleColor">@color/primary_container</item>
        <item name="android:background">@color/background</item>
    </style>

    <style name="Widget.PitchCoach.TextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/surface</item>
        <item name="boxStrokeColor">@color/text_input_stroke</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">1.5dp</item>
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="hintTextColor">@color/text_muted</item>
        <item name="android:textColorHint">@color/text_muted</item>
    </style>

    <style name="Widget.PitchCoach.Slider" parent="Widget.Material3.Slider">
        <item name="trackColorActive">@color/primary</item>
        <item name="trackColorInactive">@color/border</item>
        <item name="thumbColor">@color/primary</item>
        <item name="haloColor">@color/primary_container</item>
        <item name="labelStyle">@style/Widget.Material3.Slider.Label</item>
    </style>

    <style name="ThemeOverlay.PitchCoach.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorPrimary">@color/red</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="fontFamily">@font/inter</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.PitchCoach.Dialog</item>
    </style>

    <style name="ShapeAppearance.PitchCoach.Dialog" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">28dp</item>
    </style>

    <style name="ShapeAppearance.PitchCoach.BottomSheet" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">28dp</item>
        <item name="cornerSizeTopRight">28dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <style name="ThemeOverlay.PitchCoach.BottomSheet" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="android:fontFamily">@font/inter</item>
        <item name="fontFamily">@font/inter</item>
        <item name="bottomSheetStyle">@style/Widget.PitchCoach.BottomSheet</item>
    </style>

    <style name="Widget.PitchCoach.BottomSheet" parent="Widget.Material3.BottomSheet">
        <item name="backgroundTint">@color/surface</item>
        <item name="shapeAppearance">@style/ShapeAppearance.PitchCoach.BottomSheet</item>
    </style>
</resources>
